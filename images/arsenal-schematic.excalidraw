    {
      "type": "text",
      "id": "t-fact",
      "x": 180, "y": 620,
      "text": "Key facts:\n- Peak: 16,000 workers in 1570 (≈8% of Venice's population)\n- Could produce a fully-armed galley in 30 days\n- Standardized parts: 'Arsenal system' = interchangeable components\n- The 'Tezon' (covered docks) allowed year-round construction\n- Galileo worked here as a consultant (1590s, advising on galley proportions)",
      "fontSize": 10, "fontFamily": 1, "strokeColor": "#a0aec0",
      "originalText": "Key facts:\n- Peak: 16,000 workers in 1570 (≈8% of Venice's population)\n- Could produce a fully-armed galley in 30 days\n- Standardized parts: 'Arsenal system' = interchangeable components\n- The 'Tezon' (covered docks) allowed year-round construction\n- Galileo worked here as a consultant (1590s, advising on galley proportions)",
      "autoResize": true
    }
